; Open this file in Godot 4. Engine version will be pinned after first validation.
config_version=5

[application]

config/name="Hypster"
config/description="Portrait pixel-art streamer life simulation"
run/main_scene="res://scenes/app/main.tscn"
config/features=PackedStringArray("4.0", "GL Compatibility")

[display]

window/size/viewport_width=540
window/size/viewport_height=960
window/size/window_width_override=540
window/size/window_height_override=960
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.09, 0.10, 0.12, 1)
